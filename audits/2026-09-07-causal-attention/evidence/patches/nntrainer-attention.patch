+static void applyCausalMask(Tensor &scores, unsigned int query_offset = 0) {
+  for (unsigned int b = 0; b < scores.batch(); ++b) {
+    for (unsigned int c = 0; c < scores.channel(); ++c) {
+      for (unsigned int i = 0; i < scores.height(); ++i) {
+        for (unsigned int j = query_offset + i + 1; j < scores.width(); ++j) {
+          scores.setValue(b, c, i, j, -std::numeric_limits<float>::infinity());
+        }
+      }
+    }
+  }
+}
